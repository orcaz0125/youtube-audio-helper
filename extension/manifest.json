{
  "manifest_version": 3,
  "name": "YouTube 音频下载",
  "version": "0.4.0",
  "description": "下载 MP3，自动把调性与 BPM 写入文件名。work by orcaz",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
